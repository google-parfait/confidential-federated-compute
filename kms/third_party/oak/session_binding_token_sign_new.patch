# Sign length-prefixed assertion binding tokens by default.
#
# Applied on top of session_binding_token_compat.patch. That patch makes peers
# sign the legacy token and verify both the length-prefixed and the legacy token.
# Now that every KMS deployment runs it, flip the default so that all Oak
# sessions in the KMS (TCP replica channel, storage service and attestation
# transparency service) sign the length-prefixed token while still verifying
# both formats (b/582926369).
#
# Peers running the compat patch verify both formats, so this can be rolled
# out over them. It is NOT compatible with peers that only verify the legacy
# token (e.g. Oak f7393a19).
#
# Oak's own tests that assume the legacy default are not built by the KMS.
# Remove this patch together with session_binding_token_compat.patch when moving
# to an Oak version that signs the length-prefixed token natively.
diff --git a/oak_session/src/config.rs b/oak_session/src/config.rs
index 8d99a8bed..1201fa14f 100644
--- a/oak_session/src/config.rs
+++ b/oak_session/src/config.rs
@@ -174,7 +174,7 @@ impl SessionConfigBuilder {
             self_static_private_key: None,
             peer_static_public_key: None,
             session_binders: BTreeMap::new(),
-            use_length_prefixed_binding_token: false,
+            use_length_prefixed_binding_token: true,
         };
 
         let encryptor_config =

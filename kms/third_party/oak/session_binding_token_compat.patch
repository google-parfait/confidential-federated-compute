+    /// Current-version verifier that checks ECDSA signatures against the
+    /// `bound_data` passed by Oak Session and records how many verification
+    /// attempts were made.
+    struct CountingSignatureVerifier {
+        calls: Arc<AtomicUsize>,
+    }
+
+    #[derive(Debug)]
+    struct CountingVerifiedAssertion {
+        assertion: Assertion,
+        verifying_key: VerifyingKey,
+        calls: Arc<AtomicUsize>,
+    }
+
+    impl VerifiedBoundAssertion for CountingVerifiedAssertion {
+        fn assertion(&self) -> &Assertion {
+            &self.assertion
+        }
+
+        fn verify_binding(
+            &self,
+            bound_data: &[u8],
+            binding: &SessionBinding,
+        ) -> core::result::Result<(), BoundAssertionVerificationError> {
+            self.calls.fetch_add(1, Ordering::SeqCst);
+            let signature = Signature::from_slice(&binding.binding).map_err(|e| {
+                BoundAssertionVerificationError::BindingVerificationFailure {
+                    error_msg: format!("invalid signature: {e}"),
+                }
+            })?;
+            self.verifying_key.verify(bound_data, &signature).map_err(|e| {
+                BoundAssertionVerificationError::BindingVerificationFailure {
+                    error_msg: format!("signature mismatch: {e}"),
+                }
+            })
+        }
+    }
+
+    impl BoundAssertionVerifier for CountingSignatureVerifier {
+        fn verify_assertion(
+            &self,
+            assertion: &Assertion,
+        ) -> core::result::Result<Box<dyn VerifiedBoundAssertion>, BoundAssertionVerificationError>
+        {
+            let verifying_key = VerifyingKey::from_sec1_bytes(&assertion.content).map_err(|e| {
+                BoundAssertionVerificationError::GenericFailure {
+                    error_msg: format!("invalid key: {e}"),
+                }
+            })?;
+            Ok(Box::new(CountingVerifiedAssertion {
+                assertion: assertion.clone(),
+                verifying_key,
+                calls: self.calls.clone(),
+            }))
+        }
+    }
+
+    /// Emulates a peer pinned to a single binding token format (either
+    /// pre-f509cc9b legacy-only or 06903274 length-prefixed-only) that ignores
+    /// fallback logic and strictly verifies the wire signature against a single
+    /// `pinned_attestation_binding_token`.
+    struct StrictPinnedTokenVerifier {
+        pinned_attestation_binding_token: Vec<u8>,
+        handshake_hash: Arc<Mutex<Option<Vec<u8>>>>,
+    }
+
+    #[derive(Debug)]
+    struct StrictPinnedVerifiedAssertion {

+    /// Captures the raw Noise handshake hash via `session_binders` (which run
+    /// right before `self_assertions` are bound) so that an emulated
+    /// fixed-format peer can derive a session binding token from a pinned
+    /// attestation binding token.
+    struct HandshakeHashCapture {
+        handshake_hash: Arc<Mutex<Option<Vec<u8>>>>,
+    }
+
+    impl SessionBinder for HandshakeHashCapture {
+        fn bind(&self, bound_data: &[u8]) -> Vec<u8> {
+            *self.handshake_hash.lock().unwrap() = Some(bound_data.to_vec());
+            Vec::new()
+        }
+    }
+
+    /// Emulates a peer built at a fixed Oak Session version that always signs
+    /// `create_session_binding_token(pinned_token, handshake_hash)`.
+    struct PinnedTokenAssertionGenerator {
+        signing_key: SigningKey,
+        pinned_attestation_binding_token: Vec<u8>,
+        handshake_hash: Arc<Mutex<Option<Vec<u8>>>>,
+    }
+
+    struct PinnedTokenAssertion {
+        assertion: Assertion,
+        signing_key: SigningKey,
+        pinned_attestation_binding_token: Vec<u8>,
+        handshake_hash: Arc<Mutex<Option<Vec<u8>>>>,
+    }
+
+    impl BindableAssertion for PinnedTokenAssertion {
+        fn assertion(&self) -> &Assertion {
+            &self.assertion
+        }
+
+        fn bind(
+            &self,
+            _bound_data: &[u8],
+        ) -> core::result::Result<SessionBinding, BindableAssertionGeneratorError> {
+            let handshake_hash =
+                self.handshake_hash.lock().unwrap().clone().expect("handshake hash captured");
+            let bound_data = create_session_binding_token(
+                &self.pinned_attestation_binding_token,
+                &handshake_hash,
+            );
+            let signature: Signature = self.signing_key.sign(&bound_data);
+            Ok(SessionBinding { binding: signature.to_vec() })
+        }
+    }
+
+    impl BindableAssertionGenerator for PinnedTokenAssertionGenerator {
+        fn generate(
+            &self,

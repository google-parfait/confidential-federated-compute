+                BoundAssertionVerificationError::BindingVerificationFailure {
+                    error_msg: format!("invalid signature: {e}"),
+                }
+            })?;
+            self.verifying_key.verify(&expected_bound_data, &signature).map_err(|e| {
+                BoundAssertionVerificationError::BindingVerificationFailure {
+                    error_msg: format!("strict pinned token verification failed: {e}"),
+                }
+            })
+        }
+    }
+
+    impl BoundAssertionVerifier for StrictPinnedTokenVerifier {
+        fn verify_assertion(
+            &self,
+            assertion: &Assertion,
+        ) -> core::result::Result<Box<dyn VerifiedBoundAssertion>, BoundAssertionVerificationError>
+        {

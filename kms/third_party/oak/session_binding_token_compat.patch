+        {
+            let verifying_key = VerifyingKey::from(&self.signing_key);
+            Ok(Box::new(PinnedTokenAssertion {
+                assertion: Assertion { content: verifying_key.to_sec1_bytes().to_vec() },
+                signing_key: self.signing_key.clone(),
+                pinned_attestation_binding_token: self.pinned_attestation_binding_token.clone(),
+                handshake_hash: self.handshake_hash.clone(),
+            }))
+        }
+    }

+    /// Encodes a short (< 128 byte) ASCII assertion ID identically to `prost`'s
+    /// `Message::encode_to_vec` for `String` (field tag 1, length-delimited).
+    fn encode_prost_string(s: &str) -> Vec<u8> {
+        assert!(s.len() < 128);
+        let mut out = vec![0x0a, s.len() as u8];
+        out.extend_from_slice(s.as_bytes());
+        out
+    }
+
+    /// Computes the pinned legacy (pre-f509cc9b) serialized assertion entry:
+    /// `id.encode_to_vec() || ':' || content || '|'`.
+    fn pinned_legacy_assertion_entry(id: &str, content: &[u8]) -> Vec<u8> {
+        let mut out = encode_prost_string(id);
+        out.push(b':');
+        out.extend_from_slice(content);
+        out.push(b'|');
+        out
+    }
+
+    /// Computes the pinned length-prefixed serialized assertion map:
+    /// `(entries.len() as u64).to_le_bytes() || concat(id.encode_to_vec() ||
+    /// ':' || (content.len() as u64).to_le_bytes() || content || '|')`.
+    fn pinned_length_prefixed_assertion_map(entries: &[(&str, &[u8])]) -> Vec<u8> {
+        let mut out = (entries.len() as u64).to_le_bytes().to_vec();
+        for (id, content) in entries {
+            out.extend(encode_prost_string(id));
+            out.push(b':');
+            out.extend((content.len() as u64).to_le_bytes());
+            out.extend_from_slice(content);
+            out.push(b'|');
+        }
+        out
+    }

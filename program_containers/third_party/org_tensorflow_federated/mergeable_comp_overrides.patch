# Makes the pool runner in MergeableCompExecutionContext pluggable.
# By default, MergeableCompExecutionContext uses _run_in_async_context_pool to
# dispatch subrounds across async contexts. This patch adds a pool_runner
# parameter so callers can inject a custom runner (e.g., run_resilient_subrounds)
# that provides worker failover and dynamic re-queuing on failure.
diff --git tensorflow_federated/python/core/impl/execution_contexts/mergeable_comp_execution_context.py tensorflow_federated/python/core/impl/execution_contexts/mergeable_comp_execution_context.py
index 1a84360..ee70cdd 100644

     arg_list: Sequence[object],
     execution_contexts: Sequence[federated_language.framework.AsyncContext],
+    pool_runner,
 ):
   """Invokes up to merge and merge in a pool of async contexts."""
 
@@ -555,7 +563,7 @@ async def _invoke_merge_in_async_pool(

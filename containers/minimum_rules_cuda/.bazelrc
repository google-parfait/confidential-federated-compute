import %workspace%/../../.bazelrc.common

common --@rules_cuda//cuda:compiler=clang
# Static link cuda runtime deps.
common --@rules_cuda//cuda:runtime=@cuda//:cuda_runtime_static
# Build for H100 or equivalent.
common --@rules_cuda//cuda:archs=compute_90:compute_90,sm_90
common --repo_env=CC=clang
common --action_env=CUDA_COMPILER_USE_CC_TOOLCHAIN=true
common --action_env=CUDA_CLANG_LABEL="@llvm_toolchain//:cc-toolchain-x86_64-linux"

# Settings for remote build execution platform targets. We use the CFC-defined :remote_platform
# target rather than defining a target in this workspace, so we override the default values from
# .bazelrc.common.
build:cfc-remote --extra_execution_platforms=@confidential-federated-compute//:remote_platform
build:cfc-remote --host_platform=@confidential-federated-compute//:remote_platform
build:cfc-remote --platforms=@confidential-federated-compute//:remote_platform

module(
    name = "private_inference",
    version = "0.0.1",
    compatibility_level = 1,
)

single_version_override(
    module_name = "rules_python",
    version = "1.5.4",
)

single_version_override(
    module_name = "abseil-cpp",
    version = "20260526.0",
)

bazel_dep(name = "abseil-cpp", version = "20260526.0", repo_name = "com_google_absl")
bazel_dep(name = "rules_cc", version = "0.2.0")
bazel_dep(name = "rules_distroless", version = "0.5.1")
bazel_dep(name = "rules_oci", version = "2.2.6")
bazel_dep(name = "rules_pkg", version = "1.1.0")
bazel_dep(name = "toolchains_llvm", version = "1.8.0")
bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "rules_python", version = "1.5.4")
bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "protobuf", version = "33.0-rc2", repo_name = "com_google_protobuf")
bazel_dep(name = "grpc", version = "1.78.0", repo_name = "com_github_grpc_grpc")
bazel_dep(name = "tink_cc", version = "2.4.0", repo_name = "com_google_tink")
bazel_dep(name = "nlohmann_json", version = "3.11.3")  # Needed for JSON parsing
bazel_dep(name = "rules_foreign_cc", version = "0.11.1")
bazel_dep(name = "curl", version = "8.11.0")
bazel_dep(name = "aspect_bazel_lib", version = "2.9.4")
bazel_dep(name = "googleapis", version = "0.0.0-20260223-edfe7983", repo_name = "com_google_googleapis")

# `oak` must be declared before `rules_rust` so that Oak's registered Rust
# toolchains take precedence over rules_rust's default 2021 toolchain during
# Bzlmod toolchain resolution.
bazel_dep(name = "oak")
bazel_dep(name = "rules_rust", version = "0.70.0")
bazel_dep(name = "googletest", version = "1.17.0", repo_name = "com_google_googletest")
bazel_dep(name = "private_compute_services")
bazel_dep(name = "platforms", version = "1.0.0")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.defaults(python_version = "3.13")
python.toolchain(python_version = "3.13")
use_repo(python, "python_3_13")

register_toolchains("@python_3_13//:all")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "sysroot",
    sha256 = "6cee0a33ec5646372050451f4a82fed58a872307381f6698d95cf91ab1f80715",
    url = "https://github.com/google-parfait/confidential-federated-compute/releases/download/sysroot-20260815/sysroot.tar.xz",
)

llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm", dev_dependency = True)
llvm.toolchain(
    name = "llvm_toolchain",
    llvm_version = "19.1.0",
    stdlib = {"linux-x86_64": "stdc++"},
)
llvm.sysroot(
    name = "llvm_toolchain",
    label = "@sysroot",
    targets = ["linux-x86_64"],
)
use_repo(llvm, "llvm_toolchain")

register_toolchains("@llvm_toolchain//:all")

oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "distroless_cc_debian12_base",
    digest = "sha256:6714977f9f02632c31377650c15d89a7efaebf43bab0f37c712c30fc01edb973",
    image = "gcr.io/distroless/cc-debian12",
    platforms = ["linux/amd64"],
)
use_repo(oci, "distroless_cc_debian12_base", "distroless_cc_debian12_base_linux_amd64")

bazel_dep(name = "confidential-federated-compute")
local_path_override(
    module_name = "confidential-federated-compute",
    path = "../..",
)

archive_override(
    module_name = "oak",
    integrity = "sha256-I7HdbkLQ7fhDRap2RUzVYq3W97QNOpKc5TXo0fl/gcQ=",
    patch_strip = 1,
    strip_prefix = "oak-f7393a196c9158c28cba2f9b37994a5a349083d9",
    urls = ["https://github.com/project-oak/oak/archive/f7393a196c9158c28cba2f9b37994a5a349083d9.tar.gz"],
)

bazel_dep(name = "boringssl", version = "0.20260211.0")
bazel_dep(name = "federated-compute", repo_name = "federated_compute")
archive_override(
    module_name = "federated-compute",
    integrity = "sha256-c6y4H8THI/0Ptzo8tzfydA1fdpumvmGFnnpaiUDzlpQ=",
    strip_prefix = "federated-compute-d91525f46ad7ac0eb063565b3c9b5279dcf2d7e5",
    urls = ["https://github.com/google-parfait/federated-compute/archive/d91525f46ad7ac0eb063565b3c9b5279dcf2d7e5.tar.gz"],
)

fcp_deps = use_extension("@federated_compute//fcp:extensions.bzl", "fcp_deps")
use_repo(fcp_deps, "bazel_toolchains", "org_tensorflow_federated")

bazel_dep(name = "gemma", version = "0.0.1")
archive_override(
    module_name = "gemma",
    integrity = "sha256-nJsct9hZ1G+26LO4FIGBEVJrwja7Jp10lsumnzkv5cE=",
    strip_prefix = "gemma.cpp-73f1140dca92b42a5a5cf620ad3b6d9c0c35155e",
    urls = ["https://github.com/google/gemma.cpp/archive/73f1140dca92b42a5a5cf620ad3b6d9c0c35155e.tar.gz"],
)

archive_override(
    module_name = "highway",
    integrity = "sha256-i9++XA+1SLKEUFqlL+OVtQFC79Spmd7SDWcqJo2OKNE=",
    strip_prefix = "highway-1d16731233de45a365b43867f27d0a5f73925300",
    urls = ["https://github.com/google/highway/archive/1d16731233de45a365b43867f27d0a5f73925300.tar.gz"],
)

archive_override(
    module_name = "private_compute_services",
    integrity = "sha256-ltYbQfGVOV4PlFXZbOyNKGVUaA3ZMeBweSc/UjnPGFU=",
    patches = [
        "//third_party/private_compute_services:MODULE_bazel.patch",
        "//third_party/private_compute_services:private_inference_proto.patch",
        "//third_party/private_compute_services:private_aratea_service_proto.patch",
        "//third_party/private_compute_services:anonymous_token_request_proto.patch",
        "//third_party/private_compute_services:device_attestation_request_proto.patch",
        "//third_party/private_compute_services:public_keys_proto.patch",
        "//third_party/private_compute_services:add_oakutil_build.patch",
        "//third_party/private_compute_services:add_service_api_build.patch",
        "//third_party/private_compute_services:add_api_build.patch",
    ],
    strip_prefix = "private-compute-services-a0f528e4c443bf697adb5f7801f1e7cfc01ed191",
    urls = ["https://github.com/google/private-compute-services/archive/a0f528e4c443bf697adb5f7801f1e7cfc01ed191.tar.gz"],
)

# Rust crates.
oak_crates = use_extension("@oak//bazel/crates:extensions.bzl", "aliased_crates_repository")
use_repo(oak_crates, "oak_crates_index")

single_version_override(
    module_name = "toolchains_llvm",
    patches = ["//third_party/toolchains_llvm:cc_wrapper.patch"],
)

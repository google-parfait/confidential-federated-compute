gcs_file = use_repo_rule("//:repo_rules.bzl", "gcs_file")

# Model weights are downloaded from GCS at build time.
# Default bucket: gs://private-inference-model-weights/ (in private-inference project).
# Override with: --repo_env=GCS_MODEL_BUCKET=gs://your-bucket

gcs_file(
    name = "gemma4_31b_weights",
    downloaded_file_path = "gemma-4-31B-it-Q4_K_M.gguf",
    # Gemma 4 31B Instruct, Q4_K_M (~17GB)
    gcs_url = "gs://private-inference-model-weights/gemma-4-31B-it-Q4_K_M.gguf",
)

gcs_file(
    name = "gemma4_e4b_weights",
    downloaded_file_path = "gemma-4-E4B-it-Q4_K_M.gguf",
    # Gemma 4 E4B Instruct, Q4_K_M (~4.6GB)
    gcs_url = "gs://private-inference-model-weights/gemma-4-E4B-it-Q4_K_M.gguf",
)

cuda = use_extension("@rules_cuda//cuda:extensions.bzl", "toolchain")


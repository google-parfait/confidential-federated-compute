module(
    name = "test_pytorch",
    version = "0.0.0",
    compatibility_level = 1,
)

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# go/keep-sorted start
bazel_dep(name = "aspect_rules_py", version = "1.3.1")
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "confidential-federated-compute")
bazel_dep(name = "federated-compute", repo_name = "federated_compute")
bazel_dep(name = "oak")
bazel_dep(name = "rules_distroless", version = "0.9.4")
bazel_dep(name = "rules_oci", version = "2.2.7")
bazel_dep(name = "rules_pkg", version = "1.2.0")
bazel_dep(name = "rules_python", version = "2.0.2")
bazel_dep(name = "toolchains_llvm", version = "1.11.3")
# go/keep-sorted end

# Module overrides
# go/keep-sorted start block=yes newline_separated=yes ignore_prefixes=archive_override,local_path_override,single_version_override
single_version_override(
    module_name = "abseil-cpp",
    version = "20260526.0",
)

local_path_override(
    module_name = "confidential-federated-compute",
    path = "../..",
)

archive_override(
    module_name = "federated-compute",
    integrity = "sha256-P4Tni8dgFv4cqnmLyxQg2owQ/g6rm0mRu6uovC5GgD8=",
    patches = ["@@confidential-federated-compute+//third_party/federated_compute:libcppbor.patch"],
    strip_prefix = "federated-compute-bb01e11345332e41310de70d2672b37eedd8b285",
    urls = ["https://github.com/google-parfait/federated-compute/archive/bb01e11345332e41310de70d2672b37eedd8b285.tar.gz"],
)

archive_override(
    module_name = "oak",
    integrity = "sha256-ZV8oBz/apV5MUQzpkbNb1PGRT+5/TjbvNTIkrdlIhME=",
    strip_prefix = "oak-fe9cc4a289863bf70f623dc4d096e21d2cad8d2f",
    urls = ["https://github.com/project-oak/oak/archive/fe9cc4a289863bf70f623dc4d096e21d2cad8d2f.tar.gz"],
)

single_version_override(
    module_name = "toolchains_llvm",
    patches = ["@@confidential-federated-compute+//third_party/toolchains_llvm:cc_wrapper.patch"],
)
# go/keep-sorted end

http_archive(
    name = "sysroot",
    sha256 = "6cee0a33ec5646372050451f4a82fed58a872307381f6698d95cf91ab1f80715",
    url = "https://github.com/google-parfait/confidential-federated-compute/releases/download/sysroot-20260815/sysroot.tar.xz",
)

http_archive(
    name = "gemma_pytorch",
    build_file = "third_party/gemma_pytorch/gemma_pytorch.BUILD.bzl",
    integrity = "sha256-VRl0IYy9eiMjEJERxZLI+qxNzweioer0flWVdEsCFbI=",
    strip_prefix = "gemma_pytorch-014acb7ac4563a5f77c76d7ff98f31b568c16508",
    url = "https://github.com/google/gemma_pytorch/archive/014acb7ac4563a5f77c76d7ff98f31b568c16508.tar.gz",
)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    configure_coverage_tool = False,
    ignore_root_user_error = True,
    python_version = "3.13",
)

# Set up cc toolchain
llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm", dev_dependency = True)
llvm.toolchain(
    name = "llvm_toolchain",
    llvm_version = "19.1.0",
    stdlib = {"linux-x86_64": "stdc++"},
)
llvm.sysroot(
    name = "llvm_toolchain",
    label = "@sysroot",
    targets = ["linux-x86_64"],
)
use_repo(llvm, "llvm_toolchain")

register_toolchains("@llvm_toolchain//:all")

oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "distroless_cc_debian12_base",
    digest = "sha256:6714977f9f02632c31377650c15d89a7efaebf43bab0f37c712c30fc01edb973",
    image = "gcr.io/distroless/cc-debian12",
    platforms = ["linux/amd64"],
)
use_repo(oci, "distroless_cc_debian12_base", "distroless_cc_debian12_base_linux_amd64")

apt = use_extension("@rules_distroless//apt:extensions.bzl", "apt")
apt.sources_list(
    architectures = ["amd64"],
    components = [
        "contrib",
        "main",
    ],
    suites = ["bookworm"],
    types = ["deb"],
    uris = [
        "https://snapshot-cloudflare.debian.org/archive/debian/20260815T000000Z",
        "https://snapshot.debian.org/archive/debian/20260815T000000Z",
    ],
)

# Install some basic packages, including those needed by the aspect-build/rules_py launcher.
apt.install(
    dependency_set = "bookworm",
    packages = [
        "apt",
        "bash",
        "coreutils",
        "gawk",
        "grep",
        "sed",
    ],
    suites = ["bookworm"],
)
use_repo(apt, "bookworm")

# Define the PIP deps we need from the requirements.in file.
pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    experimental_extra_index_urls = ["https://pypi.org/simple/"],
    experimental_index_url = "https://download.pytorch.org/whl/cu128",
    hub_name = "pip",
    python_version = "3.13",
    requirements_lock = "//:requirements_lock.txt",
)
use_repo(pip, "pip")

module(
    name = "sentence_transformers",
    version = "0.0.1",
    compatibility_level = 1,
)

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# go/keep-sorted start
bazel_dep(name = "abseil-cpp", version = "20260526.0", repo_name = "com_google_absl")
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "boringssl", version = "0.20260211.0")
bazel_dep(name = "confidential-federated-compute")
bazel_dep(name = "federated-compute", repo_name = "federated_compute")
bazel_dep(name = "googleapis", version = "0.0.0-20260223-edfe7983", repo_name = "com_google_googleapis")
bazel_dep(name = "googletest", version = "1.17.0.bcr.2")
bazel_dep(name = "grpc", version = "1.80.0", repo_name = "com_github_grpc_grpc")
bazel_dep(name = "libarchive", version = "3.8.1")
bazel_dep(name = "oak")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "protobuf", version = "33.1", repo_name = "com_google_protobuf")
bazel_dep(name = "pybind11_bazel", version = "2.13.6")
bazel_dep(name = "rules_cc", version = "0.2.18")
bazel_dep(name = "rules_distroless", version = "0.6.1")
bazel_dep(name = "rules_license", version = "1.0.0")
bazel_dep(name = "rules_oci", version = "2.2.7")
bazel_dep(name = "rules_pkg", version = "1.2.0")
bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "rules_python", version = "2.0.2")
bazel_dep(name = "toolchains_llvm", version = "1.11.3")
# go/keep-sorted end

# Module overrides
# go/keep-sorted start block=yes newline_separated=yes ignore_prefixes=archive_override,local_path_override,single_version_override
single_version_override(
    module_name = "abseil-cpp",
    # Force 20260526.0 despite it having a lower compatibility_level than
    # earlier versions. 20260526.0 stopped setting compatibility_level because
    # it's deprecated starting in bazel 8.6.
    version = "20260526.0",
)

local_path_override(
    module_name = "confidential-federated-compute",
    path = "../../..",
)

archive_override(
    module_name = "federated-compute",
    integrity = "sha256-v0FFMxIF5So4vBCinqbf60A19ttXDWT+3gYrqBzipO4=",
    patches = ["@@confidential-federated-compute+//third_party/federated_compute:libcppbor.patch"],
    strip_prefix = "federated-compute-aad3eb5a4b6d075978ec3e126a036be6022f6012",
    urls = ["https://github.com/google-parfait/federated-compute/archive/aad3eb5a4b6d075978ec3e126a036be6022f6012.tar.gz"],
)

archive_override(
    module_name = "oak",
    integrity = "sha256-I7HdbkLQ7fhDRap2RUzVYq3W97QNOpKc5TXo0fl/gcQ=",
    strip_prefix = "oak-f7393a196c9158c28cba2f9b37994a5a349083d9",
    urls = ["https://github.com/project-oak/oak/archive/f7393a196c9158c28cba2f9b37994a5a349083d9.tar.gz"],
)

single_version_override(
    module_name = "toolchains_llvm",
    patches = ["@@confidential-federated-compute+//third_party/toolchains_llvm:cc_wrapper.patch"],
)
# go/keep-sorted end

internal_configure = use_extension("@pybind11_bazel//:internal_configure.bzl", "internal_configure_extension")
use_repo(internal_configure, "pybind11")

fcp_deps = use_extension("@federated_compute//fcp:extensions.bzl", "fcp_deps")
use_repo(fcp_deps, "bazel_toolchains", "libcppbor", "org_tensorflow_federated")

http_archive(
    name = "sysroot",
    sha256 = "6cee0a33ec5646372050451f4a82fed58a872307381f6698d95cf91ab1f80715",
    url = "https://github.com/google-parfait/confidential-federated-compute/releases/download/sysroot-20260815/sysroot.tar.xz",
)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    configure_coverage_tool = False,
    ignore_root_user_error = True,
    python_version = "3.13",
)

# Use the stripped python-build-standalone build. The default build ships a
# ~250 MB libpython with debug info, and the container image would carry two
# copies of it (libpython3.13.so and libpython3.13.so.1.0 in _solib_k8). Keep
# the minor_mapping, the version and the URL in sync when upgrading Python.
python.override(
    minor_mapping = {"3.13": "3.13.13"},
)
python.single_version_platform_override(
    platform = "x86_64-unknown-linux-gnu",
    python_version = "3.13.13",
    sha256 = "13d3b6d15f4c3c1dd1955a3c81e06bdc5aef4cb5cb65076878374948be3b0412",
    strip_prefix = "python",
    urls = ["https://github.com/astral-sh/python-build-standalone/releases/download/20260414/cpython-3.13.13+20260414-x86_64-unknown-linux-gnu-install_only_stripped.tar.gz"],
)

# Set up cc toolchain
llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm", dev_dependency = True)
llvm.toolchain(
    name = "llvm_toolchain",
    llvm_version = "19.1.0",
)
llvm.sysroot(
    name = "llvm_toolchain",
    label = "@sysroot",
    targets = ["linux-x86_64"],
)
use_repo(llvm, "llvm_toolchain")

register_toolchains("@llvm_toolchain//:all")

oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "python_3_13_slim_bookworm",
    digest = "sha256:e32be0e55814a08977501ca863271d9bd02443710db8f2afaf8372e2c4508530",
    image = "python",
    platforms = ["linux/amd64"],
)
use_repo(oci, "python_3_13_slim_bookworm", "python_3_13_slim_bookworm_linux_amd64")

# Define the PIP deps we need from the requirements.in file.
pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    experimental_extra_index_urls = ["https://pypi.org/simple"],
    # Pull CPU-only PyTorch wheels first to avoid ~6 GB of unused CUDA/Triton deps.
    experimental_index_url = "https://download.pytorch.org/whl/cpu",
    hub_name = "pip",
    python_version = "3.13",
    requirements_lock = "//:requirements_lock.txt",
)
use_repo(pip, "pip")

import %workspace%/../../.bazelrc.common
import %workspace%/../../.bazelrc.common.rust

build --force_pic

build --@rules_rust//rust/settings:rustfmt.toml=//:.rustfmt.toml

# Bazel relies on its configured C++ toolchain (e.g., toolchains_llvm in this
# project) to provide the linker and manage linking flags. This ensures that all
# binaries, whether built from C++ or Rust, use the same linker. Rust toolchains
# typically come with a bundled copy of the LLVM linker, called rust-lld.  The
# two flags below force rustc to fall back to the external linker provided by
# Bazel's C++ toolchain.
build --@rules_rust//rust/settings:extra_rustc_flag="-Clink-self-contained=no"
build --@rules_rust//rust/settings:extra_exec_rustc_flag="-Clink-self-contained=no"

build:ubsan --linkopt=-Wl,--allow-shlib-undefined
